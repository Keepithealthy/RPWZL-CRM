# Copy to .env.local (never commit it). Only the PUBLIC values below may ever be in the app.
# Supabase dashboard -> Project Settings -> API: Project URL and the publishable key (sb_publishable_...).
# Never put the secret key (sb_secret_...) or the database password here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
